    <entry>
        <ent_seq>1002980</ent_seq>
        <r_ele>
            <reb kana_type="HIRAGANA" romaji="kara">から</reb>
            <re_pri>spec1</re_pri>
        </r_ele>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates starting location or time, or point of separation; as ...～...まで when setting a scope</s_inf>
            <s_inf xml:lang="pol">wskazuje lokalizację, czas początkowy lub punkt rozdzielenia; jako ...～...まで</s_inf>
            <gloss xml:lang="eng">from</gloss>
            <gloss xml:lang="eng">since</gloss>
            <gloss xml:lang="eng">at</gloss>
            <gloss xml:lang="pol">od</gloss>
            <gloss xml:lang="pol">z</gloss>
            <gloss xml:lang="pol">po</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates passage or transit</s_inf>
            <s_inf xml:lang="pol">np. okno, drzwi, wskazuje na przejście</s_inf>
            <gloss xml:lang="eng">through (e.g. a window, door)</gloss>
            <gloss xml:lang="eng">via</gloss>
            <gloss xml:lang="eng">by</gloss>
            <gloss xml:lang="eng">from</gloss>
            <gloss xml:lang="pol">przez</gloss>
            <gloss xml:lang="pol">poprzez</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <s_inf xml:lang="eng">after a verb or i-adjective; だ～ after a noun or na-adjective</s_inf>
            <s_inf xml:lang="pol">po czasowniku lub i-przymiotniku; だ～ po rzeczowniku lub na-przymiotnku</s_inf>
            <gloss xml:lang="eng">because</gloss>
            <gloss xml:lang="eng">as</gloss>
            <gloss xml:lang="eng">since</gloss>
            <gloss xml:lang="eng">so</gloss>
            <gloss xml:lang="eng">therefore</gloss>
            <gloss xml:lang="pol">ponieważ</gloss>
            <gloss xml:lang="pol">jako że</gloss>
            <gloss xml:lang="pol">skoro</gloss>
            <gloss xml:lang="pol">więc</gloss>
            <gloss xml:lang="pol">w związku z tym</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates constituency</s_inf>
            <s_inf xml:lang="pol">jako zrobiony z lub składający się z (np. elementów, części)</s_inf>
            <gloss xml:lang="eng">from (as in "made from")</gloss>
            <gloss xml:lang="eng">of (as in "consisting of")</gloss>
            <gloss xml:lang="eng">out of</gloss>
            <gloss xml:lang="pol">z</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates source domain</s_inf>
            <s_inf xml:lang="pol">oznacza domenę źródłową</s_inf>
            <gloss xml:lang="eng">from (as in "a quotation from a book")</gloss>
            <gloss xml:lang="eng">out of (as in "out of 10 people")</gloss>
            <gloss xml:lang="eng">from among</gloss>
            <gloss xml:lang="pol">z (jako np. cytat z książki)</gloss>
            <gloss xml:lang="pol">spośród (np. 10 osób)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">after the -te form of a verb</s_inf>
            <s_inf xml:lang="pol">po formie te czasownika</s_inf>
            <gloss xml:lang="eng">after (doing)</gloss>
            <gloss xml:lang="eng">since</gloss>
            <gloss xml:lang="pol">po zrobieniu</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates origin of action</s_inf>
            <s_inf xml:lang="pol">wskazuje na źródło czynności, np. zostać zbesztanym przez</s_inf>
            <gloss xml:lang="eng">from</gloss>
            <gloss xml:lang="eng">by (as in "getting scolded by")</gloss>
            <gloss xml:lang="pol">z</gloss>
            <gloss xml:lang="pol">przez</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates basis or standpoint; oft. ～見て, ～言って or ～すると</s_inf>
            <s_inf xml:lang="pol">oznacza podstawę lub punkt widzenia; często w połączeniu z ～見て, ～言って lub ～すると</s_inf>
            <gloss xml:lang="eng">from (e.g. one's viewpoint)</gloss>
            <gloss xml:lang="eng">based on</gloss>
            <gloss xml:lang="eng">according to</gloss>
            <gloss xml:lang="eng">in (e.g. one's eyes)</gloss>
            <gloss xml:lang="eng">by</gloss>
            <gloss xml:lang="pol">z (np. z punktu widzenia kogoś)</gloss>
            <gloss xml:lang="pol">na podstawie</gloss>
            <gloss xml:lang="pol">zgodnie z</gloss>
            <gloss xml:lang="pol">w (np. w oczach kogoś)</gloss>
            <gloss xml:lang="pol">przez</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates reason, cause or motive</s_inf>
            <s_inf xml:lang="pol">oznacza powód, przyczynę lub motyw</s_inf>
            <gloss xml:lang="eng">because of</gloss>
            <gloss xml:lang="eng">from</gloss>
            <gloss xml:lang="eng">out of (curiosity, necessity, etc.)</gloss>
            <gloss xml:lang="eng">due to</gloss>
            <gloss xml:lang="eng">by</gloss>
            <gloss xml:lang="eng">owing to</gloss>
            <gloss xml:lang="pol">z</gloss>
            <gloss xml:lang="pol">z powodu (np. ciekawości, konieczności i etc)</gloss>
            <gloss xml:lang="pol">ponieważ</gloss>
            <gloss xml:lang="pol">przez</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">emphasizes an amount; ～（ある／の）for weight, distance, size or general quantity, ～する for price and ～の for people</s_inf>
            <s_inf xml:lang="pol">podkreśla ilość; ～（ある／の）w odniesieniu do wagi, odległości, rozmiaru lub ogólnej ilości, ～する w odniesieniu do ceny oraz ～の w odniesieniu do osób</s_inf>
            <gloss xml:lang="eng">as much as</gloss>
            <gloss xml:lang="eng">upwards of</gloss>
            <gloss xml:lang="eng">at least</gloss>
            <gloss xml:lang="eng">more than</gloss>
            <gloss xml:lang="pol">aż</gloss>
            <gloss xml:lang="pol">ponad</gloss>
            <gloss xml:lang="pol">co najmniej</gloss>
            <gloss xml:lang="pol">więcej niż</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <gloss xml:lang="eng">marks the starting state of a change</gloss>
            <gloss xml:lang="pol">oznacza stan początkowy zmiany</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2209490" sno="1" xr="いいから">いいから[1]</xref>
            <misc>colloquial</misc>
            <s_inf xml:lang="eng">at sentence end</s_inf>
            <s_inf xml:lang="pol">na końcu zdania</s_inf>
            <gloss xml:lang="eng">expresses warning, sympathy, excitement or determination</gloss>
            <gloss xml:lang="eng">emphasizes the previous statement</gloss>
            <gloss xml:lang="pol">wyraża ostrzeżenie, współczucie, podekscytowanie lub determinację</gloss>
            <gloss xml:lang="pol">podkreśla poprzednią wypowiedź</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <misc>colloquial</misc>
            <s_inf xml:lang="eng">at sentence end</s_inf>
            <s_inf xml:lang="pol">na końcu zdania</s_inf>
            <gloss xml:lang="eng">trails off with an implied reason or consequence left unstated</gloss>
            <gloss xml:lang="eng">so ...</gloss>
            <gloss xml:lang="pol">wyrażenie urywa się, sugerując przyczynę lub konsekwencję, która pozostaje niewypowiedziana</gloss>
            <gloss xml:lang="pol">więc…</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">as ～（して／が）or にして～; when comparing to the most basic example of something; emphatic</s_inf>
            <s_inf xml:lang="pol">jako ～（して／が）lub にして～; w porównaniu z najprostszym przykładem czegoś; dla podkreślenia</s_inf>
            <gloss xml:lang="eng">even</gloss>
            <gloss xml:lang="eng">to begin with, even ...</gloss>
            <gloss xml:lang="eng">right from ...</gloss>
            <gloss xml:lang="eng">starting with ... (let alone)</gloss>
            <gloss xml:lang="pol">nawet</gloss>
            <gloss xml:lang="pol">na samym początku, nawet …</gloss>
            <gloss xml:lang="pol">już od …</gloss>
            <gloss xml:lang="pol">zaczynając od… (nie mówiąc już o …)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <s_inf xml:lang="eng">as ～といって or ～って; oft. with a neg. sentence</s_inf>
            <s_inf xml:lang="pol">jako ～といって lub ～って; często w zdaniu przeczącym</s_inf>
            <gloss xml:lang="eng">it is precisely due to ... (one can't)</gloss>
            <gloss xml:lang="eng">it is because ...</gloss>
            <gloss xml:lang="pol">to właśnie z powodu … (nie da się)</gloss>
            <gloss xml:lang="pol">to dlatego …</gloss>
        </sense>

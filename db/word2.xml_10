            <s_inf xml:lang="pol">jako ～（に）は; wskazuje, że to, co nastąpi, jest naturalne lub oczekiwane</s_inf>
            <gloss xml:lang="eng">now that</gloss>
            <gloss xml:lang="eng">since</gloss>
            <gloss xml:lang="eng">so long as</gloss>
            <gloss xml:lang="eng">because</gloss>
            <gloss xml:lang="pol">teraz, gdy</gloss>
            <gloss xml:lang="pol">skoro</gloss>
            <gloss xml:lang="pol">dopóki</gloss>
            <gloss xml:lang="pol">ponieważ</gloss>
        </sense>

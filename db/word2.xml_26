            <keb>ガラパゴス現象</keb>
        </k_ele>
        <r_ele>
            <reb kana_type="KATAKANA_HIRAGANA" romaji="garapagosu genshou">ガラパゴスげんしょう</reb>
        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <xref type="see" seq="2692740" xk="ガラパゴス化">ガラパゴス化</xref>
            <s_inf xml:lang="eng">because the Galapagos contains many endemic species</s_inf>
            <gloss xml:lang="eng">Galapagos phenomenon</gloss>
            <gloss xml:lang="eng">Galapagos syndrome</gloss>
            <gloss g_type="expl" xml:lang="eng">tendency of Japanese products (e.g. cell phones) to be designed specifically for the domestic market, which are therefore unsuccessful overseas and also vulnerable to competition from imports</gloss>
            <gloss xml:lang="pol">zjawisko Galapagos</gloss>
            <gloss xml:lang="pol">syndrom Galapagos</gloss>
            <gloss xml:lang="pol">tendencja japońskich produktów (np. telefonów komórkowych), które są projektowane na wewnętrzny rynek i dlatego też nie osiągają sukcesu zagranicą i które są również narażone na konkurencję ze strony produktów importowanych</gloss>
        </sense>
        <misc>
            <oldPolishJapaneseDictionary>
                <entries id="172787" dictionaryEntryTypeList="WORD_NOUN" kanji="ガラパゴス現象" kana="ガラパゴスげんしょう" romaji="garapagosu genshou" uniqueKey="ガラパゴス現象/ガラパゴスげんしょう/1"/>
                <attributeList type="PRIORITY" value="255"/>
                <groupsList>OTHER</groupsList>
            </oldPolishJapaneseDictionary>
        </misc>

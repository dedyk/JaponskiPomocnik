        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <misc>historical term</misc>
            <s_inf xml:lang="pol">atak na zagraniczne nieruchomości i mieszkańców Nankinu przez wojska Kuomintangu w marcu 1927 r.</s_inf>
            <gloss xml:lang="eng">Nanking Incident (targeting of Nanking's foreign properties and residents by Kuomintang troops in March, 1927)</gloss>
            <gloss xml:lang="pol">Incydent z Nanking</gloss>

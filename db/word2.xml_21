                <entries id="123507" dictionaryEntryTypeList="WORD_EXPRESSION,WORD_NOUN" kanji="マクスウェルの魔物" kana="マクスウェルのまもの" romaji="makusuweru no mamono" uniqueKey="マクスウェルの魔物/マクスウェルのまもの/1"/>

    <entry>
        <ent_seq>2157940</ent_seq>
        <k_ele>
            <keb>マクスウェルの魔物</keb>
        </k_ele>
        <r_ele>
            <reb kana_type="KATAKANA_HIRAGANA" romaji="makusuweru no mamono">マクスウェルのまもの</reb>

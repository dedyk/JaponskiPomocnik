    <entry>
        <ent_seq>2116450</ent_seq>
        <k_ele>
            <keb>赤菱</keb>
        </k_ele>
        <r_ele>
            <reb kana_type="HIRAGANA" romaji="akabishi">あかびし</reb>
        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <s_inf xml:lang="pol">nowy znak ochronny wprowadzony III Protokołem Dodatkowym do konwencji genewskich o ochronie ofiar wojny z dnia 12 sierpnia 1949 r. Celem wprowadzenia nowego znaku nie było zastąpienie pozostałych znaków (Czerwonego Krzyża, Półksiężyca, Gwiazdy Dawida) nowym, nie kojarzącym się ani z chrześcijaństwem, ani z islamem, ani z judaizmem, ani z żadną inną religią – ale stworzenie neutralnego, nowego obok istniejących w prawie międzynarodowym znaku</s_inf>
            <gloss xml:lang="eng">Red Crystal (politically and religiously neutral emblem used by the International Committee of the Red Cross)</gloss>
            <gloss xml:lang="pol">Czerwony Kryształ</gloss>
        </sense>
        <misc>

<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<JMdict>
    <entry>
        <ent_seq>2100000</ent_seq>
        <k_ele>
            <keb>十七条憲法</keb>
        </k_ele>
        <r_ele>
            <reb kana_type="HIRAGANA" romaji="juu shichi jou kenpou">じゅうしちじょうけんぽう</reb>
        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <s_inf xml:lang="pol">dokument datowany na 604 r. i przypisywany księciu Shōtoku. Jego treść została przekazana w Nihon shoki. Konstytucja, przyjęta za panowania cesarzowej Suiko, nie określa podstaw prawnych państwa. Zawarty jest w niej opis cech charakteru i wartości moralnych, jakie reprezentować sobą powinni urzędnicy i poddani, żeby państwo funkcjonowało sprawnie. Najwyższą władzę sprawować miał cesarz. Dokument odznacza się wyraźnymi wpływami buddyjskimi.</s_inf>
            <gloss xml:lang="eng">The Seventeen-Article Constitution</gloss>
            <gloss xml:lang="pol">Konstytucja Siedemnastu Artykułów</gloss>
        </sense>
        <misc>
            <oldPolishJapaneseDictionary>
                <entries id="203195" dictionaryEntryTypeList="WORD_NOUN" kanji="十七条憲法" kana="じゅうしちじょうけんぽう" romaji="juu shichi jou kenpou" uniqueKey="十七条憲法/じゅうしちじょうけんぽう/1"/>
                <attributeList type="PRIORITY" value="255"/>
                <groupsList>OTHER</groupsList>
            </oldPolishJapaneseDictionary>
        </misc>
    </entry>

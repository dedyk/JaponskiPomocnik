    <entry>
        <ent_seq>2225910</ent_seq>
        <k_ele>
            <keb>倍数比例の法則</keb>
        </k_ele>
        <r_ele>
            <reb kana_type="HIRAGANA" romaji="baisuu hirei no housoku">ばいすうひれいのほうそく</reb>
        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <s_inf xml:lang="pol">prawo chemiczne, sformułowane przez J. Daltona w 1804 r.: Jeżeli dwa pierwiastki A i B tworzą ze sobą więcej niż jeden związek, to masy pierwiastka A przypadające na taką samą masę pierwiastka B mają się do siebie jak niewielkie liczby całkowite</s_inf>
            <gloss xml:lang="eng">law of multiple proportions</gloss>
            <gloss xml:lang="pol">prawo stosunków wielokrotnych</gloss>
        </sense>
        <misc>
            <oldPolishJapaneseDictionary>
                <entries id="205679" dictionaryEntryTypeList="WORD_NOUN" kanji="倍数比例の法則" kana="ばいすうひれいのほうそく" romaji="baisuu hirei no housoku" uniqueKey="倍数比例の法則/ばいすうひれいのほうそく/1"/>
                <attributeList type="PRIORITY" value="255"/>
                <groupsList>OTHER</groupsList>
            </oldPolishJapaneseDictionary>
        </misc>
    </entry>
    <entry>

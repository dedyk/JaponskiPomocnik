        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <s_inf xml:lang="pol">sformułowane w połowie XVII w. przez Blaise’a Pascala prawo statyki płynów. Prawo określa ciśnienie w płynie</s_inf>
            <gloss xml:lang="eng">Pascal's law</gloss>
            <gloss xml:lang="pol">prawo Pascala</gloss>
        </sense>
        <misc>
            <oldPolishJapaneseDictionary>

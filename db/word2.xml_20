    <entry>
        <ent_seq>2028990</ent_seq>
        <r_ele>
            <reb kana_type="HIRAGANA" romaji="ni">に</reb>
            <re_pri>spec1</re_pri>
        </r_ele>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates place or time</s_inf>
            <s_inf xml:lang="pol">wskazuje na miejsce lub czas</s_inf>
            <gloss xml:lang="eng">at</gloss>
            <gloss xml:lang="eng">in</gloss>
            <gloss xml:lang="eng">on</gloss>
            <gloss xml:lang="pol">w</gloss>
            <gloss xml:lang="pol">na</gloss>
            <gloss xml:lang="pol">o</gloss>
            <gloss xml:lang="pol">podczas</gloss>
            <gloss xml:lang="pol">w czasie</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates direction</s_inf>
            <s_inf xml:lang="pol">wskazuje na kierunek</s_inf>
            <gloss xml:lang="eng">to</gloss>
            <gloss xml:lang="eng">toward</gloss>
            <gloss xml:lang="eng">into</gloss>
            <gloss xml:lang="eng">for</gloss>
            <gloss xml:lang="pol">do</gloss>
            <gloss xml:lang="pol">w kierunku</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates purpose</s_inf>
            <s_inf xml:lang="pol">wskazuje na cel</s_inf>
            <gloss xml:lang="eng">to</gloss>
            <gloss xml:lang="eng">for</gloss>
            <gloss xml:lang="eng">in order to</gloss>
            <gloss xml:lang="pol">do</gloss>
            <gloss xml:lang="pol">dla</gloss>
            <gloss xml:lang="pol">w celu</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates reason or cause</s_inf>
            <s_inf xml:lang="pol">wskazuje na powód lub przyczynę</s_inf>
            <gloss xml:lang="eng">because of</gloss>
            <gloss xml:lang="eng">for</gloss>
            <gloss xml:lang="eng">with</gloss>
            <gloss xml:lang="eng">by</gloss>
            <gloss xml:lang="eng">due to</gloss>
            <gloss xml:lang="pol">ponieważ</gloss>
            <gloss xml:lang="pol">z powodu</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">e.g. 友達～伝える</s_inf>
            <s_inf xml:lang="pol">np. 友達～伝える</s_inf>
            <gloss xml:lang="eng">marks the target of an action</gloss>
            <gloss xml:lang="eng">marks the recipient of an action</gloss>
            <gloss xml:lang="pol">oznacza cel czynności</gloss>
            <gloss xml:lang="pol">oznacza adresata czynności</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">as in 大人～なる</s_inf>
            <s_inf xml:lang="pol">jak w 大人～なる</s_inf>
            <gloss xml:lang="eng">marks the outcome of a change</gloss>
            <gloss xml:lang="eng">marks the result of an action</gloss>
            <gloss xml:lang="pol">oznacza wynik zmiany</gloss>
            <gloss xml:lang="pol">oznacza rezultat działania</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="1008590" sno="1" xr="として">として[1]</xref>
            <gloss xml:lang="eng">as (i.e. in the role of; e.g. as a teacher, as a gift)</gloss>
            <gloss xml:lang="eng">for (as in "in return for")</gloss>
            <gloss xml:lang="eng">on (i.e. on the occasion of)</gloss>
            <gloss xml:lang="eng">from (e.g. the perspective of)</gloss>
            <gloss xml:lang="pol">jako (np. jako nauczyciel, jako prezent)</gloss>
            <gloss xml:lang="pol">za (w znaczeniu w zamian za)</gloss>
            <gloss xml:lang="pol">z (np. z okazji)</gloss>
            <gloss xml:lang="pol">z (np. z perspektywy)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates place of departure or origin of action</s_inf>
            <s_inf xml:lang="pol">wskazuje miejsce wyjazdu lub miejsce, z którego pochodzi dane działanie</s_inf>
            <gloss xml:lang="eng">by</gloss>
            <gloss xml:lang="eng">from</gloss>
            <gloss xml:lang="pol">z</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="pol">np. raz w miesiącu</s_inf>
            <gloss xml:lang="eng">per</gloss>
            <gloss xml:lang="eng">in</gloss>
            <gloss xml:lang="eng">for</gloss>
            <gloss xml:lang="eng">a (as in "once a month")</gloss>
            <gloss xml:lang="pol">raz</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">marks the thing being compared to, or taken as a basis</s_inf>
            <s_inf xml:lang="pol">oznacza to, z czym coś porównujemy lub co przyjmuje się za punkt odniesienia</s_inf>
            <gloss xml:lang="eng">with</gloss>
            <gloss xml:lang="eng">to</gloss>
            <gloss xml:lang="pol">z</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates relation or domain</s_inf>
            <s_inf xml:lang="pol">oznacza relację lub dziedzinę</s_inf>
            <gloss xml:lang="eng">concerning</gloss>
            <gloss xml:lang="eng">regarding</gloss>
            <gloss xml:lang="eng">on (as in "knowledgeable on")</gloss>
            <gloss xml:lang="eng">in</gloss>
            <gloss xml:lang="eng">for (as in "suitable for")</gloss>
            <gloss xml:lang="eng">as for</gloss>
            <gloss xml:lang="eng">about</gloss>
            <gloss xml:lang="pol">dotyczący</gloss>
            <gloss xml:lang="pol">w odniesieniu do</gloss>
            <gloss xml:lang="pol">w zakresie</gloss>
            <gloss xml:lang="pol">do (np. odpowiednio do)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2576210" xr="ずに">ずに</xref>
            <xref type="see" seq="2868946" xk="一足飛びに">一足飛びに</xref>
            <s_inf xml:lang="eng">e.g. ず～, 仰向け～, 一足飛び～</s_inf>
            <s_inf xml:lang="pol">np. ず～, 仰向け～, 一足飛び～</s_inf>
            <gloss xml:lang="eng">indicates manner of action</gloss>
            <gloss xml:lang="eng">indicates a state</gloss>
            <gloss xml:lang="pol">wskazuje sposób działania</gloss>
            <gloss xml:lang="pol">wskazuje stan</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2028980" sno="3" xr="で">で[3]</xref>
            <s_inf xml:lang="eng">indicates means of action</s_inf>
            <s_inf xml:lang="pol">wskazuje środki działania</s_inf>
            <gloss xml:lang="eng">by</gloss>
            <gloss xml:lang="eng">with</gloss>
            <gloss xml:lang="eng">using</gloss>
            <gloss xml:lang="eng">via</gloss>
            <gloss xml:lang="pol">z</gloss>
            <gloss xml:lang="pol">przy użyciu</gloss>
            <gloss xml:lang="pol">za pośrednictwem</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">as ～する (or ～決める)</s_inf>
            <s_inf xml:lang="pol">np. ～する (lub ～決める)</s_inf>
            <gloss xml:lang="eng">marks the item of a decision</gloss>
            <gloss xml:lang="eng">marks the thing being decided on</gloss>
            <gloss xml:lang="pol">oznacza przedmiot decyzji</gloss>
            <gloss xml:lang="pol">oznacza sprawę, w której zapada decyzja</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2217040" sno="1" xk="ご覧になる">ご覧になる[1]</xref>
            <xref type="see" seq="1001860" xk="お見えになる">お見えになる</xref>
            <s_inf xml:lang="eng">after a noun or the -masu stem of a verb; as（お／ご）...～なる</s_inf>
            <s_inf xml:lang="pol">po rzeczowniku lub czasowniku bez masu, jako （お／ご）...～なる</s_inf>
            <gloss xml:lang="eng">forms a honorific verb</gloss>
            <gloss xml:lang="pol">tworzy czasownik honoryfikatywny</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">after the -masu stem of a verb, followed by the same verb</s_inf>
            <s_inf xml:lang="pol">po czasowniku bez masu, po którym następuje sam czasownik</s_inf>
            <gloss xml:lang="eng">indicates that an action is happening intensively</gloss>
            <gloss xml:lang="eng">emphaticizes an action</gloss>
            <gloss xml:lang="pol">wskazuje, że czynność odbywa się intensywnie</gloss>
            <gloss xml:lang="pol">podkreśla czynność</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">as ...に...（に）etc.</s_inf>
            <s_inf xml:lang="pol">jak w ...に...（に）etc.</s_inf>
            <gloss xml:lang="eng">and</gloss>
            <gloss xml:lang="eng">in addition to</gloss>
            <gloss xml:lang="pol">i</gloss>
            <gloss xml:lang="pol">w dodatku</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">as する～はするが, where する is any repeated verb; indicates concession</s_inf>
            <s_inf xml:lang="pol">jak w する～はするが, gdzie する to dowolny powtórzony czasownik; oznacza ustępstwo</s_inf>
            <gloss xml:lang="eng">I did ..., but</gloss>
            <gloss xml:lang="eng">while it is true that ...</gloss>
            <gloss xml:lang="eng">though there may be ...</gloss>
            <gloss xml:lang="pol">tak zrobiłem ..., ale</gloss>
            <gloss xml:lang="pol">chociaż prawdą jest, że ...</gloss>
            <gloss xml:lang="pol">chociaż może być ...</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2215430" sno="3" xr="には">には[3]</xref>
            <misc>honorific or respectful (sonkeigo) language</misc>
            <s_inf xml:lang="eng">as ～は, or ～も; e.g. 皆様～は</s_inf>
            <s_inf xml:lang="pol">jak w ～は, lub ～も; np. 皆様～は</s_inf>
            <gloss xml:lang="eng">indicates respect toward the subject of the sentence</gloss>
            <gloss xml:lang="pol">wskazuje na szacunek wobec podmiotu zdania</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2028980" sno="1" xr="で">で[1]</xref>
            <misc>formal or literary term</misc>
            <s_inf xml:lang="eng">indicates location of action</s_inf>
            <s_inf xml:lang="pol">wskazuje miejsce akcji</s_inf>
            <gloss xml:lang="eng">at</gloss>
            <gloss xml:lang="eng">in</gloss>
            <gloss xml:lang="pol">w</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <s_inf xml:lang="eng">as する～できない or しよう～もできない, where する is any repeated verb; e.g. 泣く～泣けない or 泣こう～も泣けない</s_inf>
            <s_inf xml:lang="pol">jak w する～できない lub しよう～もできない, gdzie する to dowolny powtórzony czasownik, np. 泣く～泣けない lub 泣こう～も泣けない</s_inf>
            <gloss xml:lang="eng">I can't ..., even if I wanted to</gloss>
            <gloss xml:lang="pol">nie potrafię…, nawet gdybym chciał</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <s_inf xml:lang="eng">as ...（よう／う）～</s_inf>
            <s_inf xml:lang="pol">jak w ...（よう／う）～</s_inf>
            <gloss xml:lang="eng">although there should be ...</gloss>
            <gloss xml:lang="eng">even though one would expect ...</gloss>
            <gloss xml:lang="pol">chociaż powinno być …</gloss>
            <gloss xml:lang="pol">chociaż można by się spodziewać …</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <xref type="see" seq="2394680" xk="思うに">思うに</xref>
            <xref type="see" seq="1546620" xk="要するに">要するに</xref>
            <s_inf xml:lang="eng">mostly limited to set phrases in modern Japanese</s_inf>
            <s_inf xml:lang="pol">we współczesnym języku japońskim ogranicza się głównie do utartych zwrotów</s_inf>
            <gloss xml:lang="eng">when</gloss>
            <gloss xml:lang="eng">if</gloss>
            <gloss xml:lang="eng">on (e.g. reflection)</gloss>
            <gloss xml:lang="pol">gdy</gloss>
            <gloss xml:lang="pol">jeśli</gloss>
            <gloss xml:lang="pol">w przypadku (np. odbicia)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <xref type="see" seq="1009980" sno="1" xr="のに">のに[1]</xref>
            <s_inf xml:lang="eng">dated or dialectal</s_inf>
            <s_inf xml:lang="pol">przestarzałe lub dialektalne</s_inf>
            <gloss xml:lang="eng">although</gloss>
            <gloss xml:lang="eng">despite</gloss>
            <gloss xml:lang="eng">even though</gloss>
            <gloss xml:lang="eng">and yet</gloss>
            <gloss xml:lang="pol">chociaż</gloss>
            <gloss xml:lang="pol">mimo że</gloss>
            <gloss xml:lang="pol">nawet jeśli</gloss>
            <gloss xml:lang="pol">a jednak</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <pos>conjunction</pos>
            <misc>archaic</misc>
            <gloss xml:lang="eng">because</gloss>
            <gloss xml:lang="eng">as</gloss>
            <gloss xml:lang="eng">since</gloss>
            <gloss xml:lang="eng">so</gloss>
            <gloss xml:lang="pol">ponieważ</gloss>
            <gloss xml:lang="pol">więc</gloss>
        </sense>
        <misc>
            <oldPolishJapaneseDictionary>
                <entries id="13596" dictionaryEntryTypeList="WORD_PARTICULE,WORD_CONJUNCTION" kana="に" romaji="ni" uniqueKey="-/に/1"/>
                <attributeList type="COMMON_WORD"/>
                <attributeList type="PRIORITY" value="104"/>
                <groupsList>OTHER</groupsList>
                <exampleSentenceGroupIdsList>10014</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10025258</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10028</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>1003666</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10038</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10058271</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10065237</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10077625</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>1008230</exampleSentenceGroupIdsList>
                <exampleSentenceGroupIdsList>10083</exampleSentenceGroupIdsList>
            </oldPolishJapaneseDictionary>
        </misc>
    </entry>
    <entry>
        <ent_seq>2029000</ent_seq>
        <r_ele>
            <reb kana_type="HIRAGANA_EXCEPTION" romaji="e">へ</reb>
            <re_pri>spec1</re_pri>
        </r_ele>
        <r_ele>
            <reb kana_type="KATAKANA_EXCEPTION" romaji="e">ェ</reb>
            <re_inf>rarely used kana form</re_inf>
        </r_ele>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates direction or goal; pronounced え in modern Japanese; occ. written as 江</s_inf>
            <s_inf xml:lang="pol">wymawiane え we współczesnym języku japońskim; zapisywane jako 江</s_inf>
            <gloss xml:lang="eng">to</gloss>
            <gloss xml:lang="eng">towards</gloss>

            <gloss xml:lang="pol">hmm</gloss>
            <gloss xml:lang="pol">cóż</gloss>
            <gloss xml:lang="pol">no cóż</gloss>
            <gloss xml:lang="pol">widzisz...</gloss>
        </sense>
        <sense>
            <pos>particle</pos>

            <xref type="see" seq="2192950" xr="なさい">なさい</xref>
            <misc>abbreviation</misc>
            <s_inf xml:lang="eng">imperative; used with -masu stem of verb</s_inf>
            <s_inf xml:lang="pol">używane po czasowniku w formie bez masu</s_inf>
            <gloss xml:lang="eng">do</gloss>
            <gloss xml:lang="pol">tryb rozkazujący (od なさい)</gloss>
        </sense>
        <sense>
            <pos>interjection (kandoushi)</pos>
            <s_inf xml:lang="eng">used to get someone's attention or press one's point</s_inf>
            <s_inf xml:lang="pol">używane do zwrócenia czyjejś uwagi lub podkreślenia swojego punktu widzenia</s_inf>

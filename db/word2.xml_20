        <sense>
            <stagr>な</stagr>
            <pos>particle</pos>
            <s_inf xml:lang="eng">prohibitive; used with dictionary form of verb</s_inf>
            <s_inf xml:lang="pol">wyraża zakaz lub ostre polecenie przy użyciu negacji, używa się po formie słownikowej czasownika</s_inf>
            <gloss xml:lang="eng">don't</gloss>
            <gloss xml:lang="pol">nie</gloss>
        </sense>
        <sense>

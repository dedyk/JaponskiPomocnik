    <entry>
        <ent_seq>2028950</ent_seq>
        <r_ele>
            <reb kana_type="HIRAGANA_EXCEPTION" romaji="to wa">とは</reb>
            <re_pri>spec1</re_pri>
        </r_ele>
        <sense>
            <pos>expressions (phrases, clauses, etc.)</pos>
            <pos>particle</pos>
            <xref type="see" seq="1008500" sno="2" xk="と言うのは" xr="というのは">と言うのは(というのは)[2]</xref>
            <gloss xml:lang="eng">indicates word or phrase being defined</gloss>
            <gloss xml:lang="pol">[wskazywanie określonego słowa lub zwrotu]</gloss>
        </sense>
        <sense>
            <pos>expressions (phrases, clauses, etc.)</pos>
            <pos>particle</pos>
            <xref type="see" seq="1008490" sno="4" xr="と">と[4]</xref>
            <s_inf xml:lang="eng">indicates contrast or adds emphasis to a negative statement</s_inf>
            <s_inf xml:lang="pol">wskazuje kontrast lub dodaje akcentu do negatywnego stwierdzenia</s_inf>
            <gloss xml:lang="eng">used for quoting (thoughts, speech, etc.)</gloss>
            <gloss xml:lang="pol">używane do cytowania (myśli, wypowiedzi itp.)</gloss>
        </sense>
        <sense>
            <pos>expressions (phrases, clauses, etc.)</pos>
            <pos>particle</pos>
            <xref type="see" seq="1008490" sno="3" xr="と">と[3]</xref>
            <s_inf xml:lang="eng">more emphatic than と</s_inf>
            <s_inf xml:lang="pol">bardziej stanowcze niż と</s_inf>
            <gloss xml:lang="eng">with</gloss>
            <gloss xml:lang="pol">z (kimś, czymś)</gloss>
        </sense>
        <sense>
            <pos>expressions (phrases, clauses, etc.)</pos>
            <pos>particle</pos>
            <s_inf xml:lang="eng">with neg. verb</s_inf>
            <s_inf xml:lang="pol">z czasownikiem w formie przeczącej</s_inf>
            <gloss xml:lang="eng">(not) as much as</gloss>
            <gloss xml:lang="eng">(not) so much as</gloss>
            <gloss xml:lang="pol">(nie) tak bardzo jak</gloss>
            <gloss xml:lang="pol">(nie) aż tak bardzo jak</gloss>
        </sense>
        <sense>
            <pos>expressions (phrases, clauses, etc.)</pos>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates surprise, disbelief, anger, etc.; sometimes at sentence end</s_inf>
            <s_inf xml:lang="pol">wskazuje na zaskoczenie, niedowierzanie, złość itp.; czasami na końcu zdania</s_inf>

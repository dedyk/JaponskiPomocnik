    <entry>
        <ent_seq>2028970</ent_seq>
        <r_ele>
            <reb kana_type="HIRAGANA" romaji="ka">か</reb>
            <re_pri>spec1</re_pri>
        </r_ele>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">at sentence end</s_inf>
            <gloss xml:lang="eng">indicates a question</gloss>
            <gloss xml:lang="pol">partykuła pytająca na końcu zdania</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">at the end of a subordinate clause</s_inf>
            <s_inf xml:lang="pol">na końcu zdania podrzędnego</s_inf>
            <gloss xml:lang="eng">indicates an embedded question</gloss>
            <gloss xml:lang="eng">indicates an indirect question</gloss>
            <gloss xml:lang="pol">oznacza pytanie pośrednie</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">as ...か...（か）</s_inf>
            <s_inf xml:lang="pol">forma wskazująca alternatywę, jako ...か...（か）</s_inf>
            <gloss xml:lang="eng">or</gloss>
            <gloss xml:lang="eng">whether or not</gloss>
            <gloss xml:lang="eng">either ... or ...</gloss>
            <gloss xml:lang="pol">albo</gloss>
            <gloss xml:lang="pol">czy ..., czy ...</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="1188270" sno="1" xk="何か">何か[1]</xref>
            <s_inf xml:lang="eng">after an interrogative</s_inf>
            <s_inf xml:lang="pol">używane po zaimku pytającym</s_inf>
            <gloss xml:lang="eng">some- (e.g. something, someone)</gloss>
            <gloss xml:lang="pol">jakiś</gloss>
            <gloss xml:lang="pol">coś</gloss>
            <gloss xml:lang="pol">ktoś</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates uncertainty, conjecture, doubt, etc.</s_inf>
            <s_inf xml:lang="pol">wskazuje na niepewność, przypuszczenie, wątpliwość itp.</s_inf>
            <gloss xml:lang="eng">hmm</gloss>
            <gloss xml:lang="eng">huh</gloss>
            <gloss xml:lang="eng">I wonder (if, why, etc.)</gloss>
            <gloss xml:lang="eng">it might (be)</gloss>
            <gloss xml:lang="eng">maybe</gloss>
            <gloss xml:lang="eng">perhaps it's (because of)</gloss>
            <gloss xml:lang="eng">could it be (that)</gloss>
            <gloss xml:lang="pol">hmm</gloss>
            <gloss xml:lang="pol">heh</gloss>
            <gloss xml:lang="pol">ciekawe (czy, dlaczego i etc)</gloss>
            <gloss xml:lang="pol">być może (z powodu)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates invitation, suggestion, or polite request; after a negative or volitional</s_inf>
            <s_inf xml:lang="pol">oznacza zaproszenie, sugestię lub uprzejmą prośbę; po zdaniu przeczącym lub wyrażającym wolę</s_inf>
            <gloss xml:lang="eng">shouldn't we ...?</gloss>
            <gloss xml:lang="eng">why don't we ...?</gloss>
            <gloss xml:lang="eng">what about ...?</gloss>
            <gloss xml:lang="eng">how about ...?</gloss>
            <gloss xml:lang="eng">let's ...</gloss>
            <gloss xml:lang="eng">may I ...?</gloss>
            <gloss xml:lang="eng">could you ...?</gloss>
            <gloss xml:lang="pol">czy nie powinniśmy...?</gloss>
            <gloss xml:lang="pol">dlaczego by nam nie...?</gloss>
            <gloss xml:lang="pol">a co z...?</gloss>
            <gloss xml:lang="pol">a może...?</gloss>
            <gloss xml:lang="pol">zróbmy...?</gloss>
            <gloss xml:lang="pol">czy mogę...?</gloss>
            <gloss xml:lang="pol">czy mógłbyś...?</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <xref type="see" seq="2066670" xk="何人か">何人か</xref>
            <s_inf xml:lang="eng">indicates a rough amount</s_inf>
            <s_inf xml:lang="pol">oznacza przybliżoną kwotę</s_inf>
            <gloss xml:lang="eng">some (amount)</gloss>
            <gloss xml:lang="eng">roughly</gloss>
            <gloss xml:lang="eng">about</gloss>
            <gloss xml:lang="eng">circa</gloss>
            <gloss xml:lang="eng">more or less</gloss>
            <gloss xml:lang="eng">or so</gloss>
            <gloss xml:lang="pol">około (ilość)</gloss>
            <gloss xml:lang="pol">mniej więcej</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates indirect command or critique; usu. after a negative</s_inf>
            <s_inf xml:lang="pol">oznacza pośrednie polecenie lub krytykę; zwykle występuje po zdaniu przeczącym</s_inf>
            <gloss xml:lang="eng">won't you ...?</gloss>
            <gloss xml:lang="eng">why don't you ...?</gloss>
            <gloss xml:lang="eng">couldn't you (e.g. have done differently)?</gloss>
            <gloss xml:lang="eng">shouldn't you ...?</gloss>
            <gloss xml:lang="pol">czy nie mógłbyś...?</gloss>
            <gloss xml:lang="pol">dlaczego nie spróbujesz...?</gloss>
            <gloss xml:lang="pol">czy nie mógłbyś (np. postąpić inaczej)?</gloss>
            <gloss xml:lang="pol">czy nie powinieneś...?</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates irony or rhetorical question</s_inf>
            <s_inf xml:lang="pol">oznacza ironię lub pytanie retoryczne</s_inf>
            <gloss xml:lang="eng">why should ...?</gloss>
            <gloss xml:lang="eng">why would ...?</gloss>
            <gloss xml:lang="eng">would I (really) ...?</gloss>
            <gloss xml:lang="eng">who could have (guessed, foreseen, etc.) ...?</gloss>
            <gloss xml:lang="eng">how could ...?</gloss>
            <gloss xml:lang="eng">how should ...?</gloss>
            <gloss xml:lang="pol">dlaczego miałby...?</gloss>
            <gloss xml:lang="pol">czy ja (naprawdę)...?</gloss>
            <gloss xml:lang="pol">kto mógłby (przewidzieć, domyślić się itp.)...?</gloss>
            <gloss xml:lang="pol">jak to możliwe, że...?</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">used to confirm or emphasize information</s_inf>
            <s_inf xml:lang="pol">służące do potwierdzenia lub podkreślenia informacji</s_inf>
            <gloss xml:lang="eng">OK?</gloss>
            <gloss xml:lang="eng">(you) understand?</gloss>
            <gloss xml:lang="eng">got it?</gloss>
            <gloss xml:lang="eng">really?</gloss>
            <gloss xml:lang="eng">right?</gloss>
            <gloss xml:lang="eng">didn't (I, you, etc.) ...?</gloss>
            <gloss xml:lang="pol">OK?</gloss>
            <gloss xml:lang="pol">rozumiesz?</gloss>
            <gloss xml:lang="pol">jasne?</gloss>
            <gloss xml:lang="pol">naprawdę?</gloss>
            <gloss xml:lang="pol">prawda?</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates surprise or strong emotion</s_inf>
            <s_inf xml:lang="pol">wyraża zaskoczenie lub silne emocje</s_inf>
            <gloss xml:lang="eng">oh</gloss>
            <gloss xml:lang="eng">wow</gloss>
            <gloss xml:lang="eng">how (incredible, strongly, badly, etc.)</gloss>
            <gloss xml:lang="pol">och</gloss>
            <gloss xml:lang="pol">wow</gloss>
            <gloss xml:lang="pol">jak (niesamowicie, bardzo, itp.)</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">indicates (sudden) realization or recollection</s_inf>
            <s_inf xml:lang="pol">oznacza (nagłe) uświadomienie lub przypomnienie sobie</s_inf>
            <gloss xml:lang="eng">come to think of ...</gloss>
            <gloss xml:lang="eng">... you say?</gloss>
            <gloss xml:lang="eng">ah</gloss>
            <gloss xml:lang="eng">now that (you, it, etc.) ...</gloss>
            <gloss xml:lang="pol">jak tak sobie pomyśleć...</gloss>
            <gloss xml:lang="pol">... mówisz?</gloss>
            <gloss xml:lang="pol">ach</gloss>
            <gloss xml:lang="pol">teraz, gdy (ty, to itp.)...</gloss>
        </sense>
        <sense>
            <pos>prefix</pos>
            <xref type="see" seq="1003060" xk="か弱い">か弱い</xref>
            <s_inf xml:lang="eng">emphatic prefix; usu. before an adjective</s_inf>
            <s_inf xml:lang="pol">przedrostek emfatyczny; zwykle przed przymiotnikiem</s_inf>
            <gloss xml:lang="eng">very</gloss>
            <gloss xml:lang="pol">bardzo</gloss>
        </sense>
        <sense>
            <pos>suffix</pos>
            <xref type="see" seq="1435360" xk="定か">定か</xref>
            <s_inf xml:lang="eng">suffix forming adjectives or adverbs; after an uninflectable word</s_inf>
            <s_inf xml:lang="pol">występujący po słowie nieodmiennym</s_inf>
            <gloss xml:lang="eng">-al</gloss>
            <gloss xml:lang="eng">-ial</gloss>
            <gloss xml:lang="eng">-ic</gloss>
            <gloss xml:lang="eng">-ical</gloss>
            <gloss xml:lang="eng">-ish</gloss>
            <gloss xml:lang="eng">-y</gloss>
            <gloss xml:lang="pol">przyrostek tworzący przymiotniki lub przysłówki</gloss>
        </sense>
        <sense>
            <pos>adverb (fukushi)</pos>
            <misc>archaic</misc>
            <gloss xml:lang="eng">in that way</gloss>
            <gloss xml:lang="pol">w ten sposób</gloss>
        </sense>
        <misc>
            <oldPolishJapaneseDictionary>
                <entries id="769" dictionaryEntryTypeList="WORD_PARTICULE,WORD_ADVERB,WORD_PREFIX,WORD_SUFFIX" kana="か" romaji="ka" uniqueKey="-/か/1"/>

            <gloss xml:lang="pol">słuchaj</gloss>
            <gloss xml:lang="pol">patrz</gloss>
            <gloss xml:lang="pol">mów</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">when seeking confirmation, for emphasis, etc.; used at sentence end</s_inf>
            <s_inf xml:lang="pol">szukając potwierdzenia, podkreślenia itp.; używane na końcu zdania</s_inf>
            <gloss xml:lang="eng">now, ...</gloss>
            <gloss xml:lang="eng">well, ...</gloss>

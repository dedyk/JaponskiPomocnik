            <gloss xml:lang="eng">say</gloss>
            <gloss xml:lang="eng">listen</gloss>
            <gloss xml:lang="eng">look</gloss>
            <gloss xml:lang="eng">come on</gloss>
            <gloss xml:lang="pol">hej</gloss>
            <gloss xml:lang="pol">słuchaj</gloss>
            <gloss xml:lang="pol">spójrz</gloss>
            <gloss xml:lang="pol">no dalej</gloss>
            <gloss xml:lang="pol">no</gloss>
            <gloss xml:lang="pol">ej</gloss>
        </sense>
        <sense>
            <pos>particle</pos>
            <s_inf xml:lang="eng">at sentence end; used to express one's thoughts or feelings</s_inf>
            <s_inf xml:lang="pol">na końcu zdania; używane do wyrażania swoich myśli lub uczuć</s_inf>
            <gloss xml:lang="eng">you know</gloss>
            <gloss xml:lang="eng">you see</gloss>
            <gloss xml:lang="eng">I must say</gloss>
            <gloss xml:lang="eng">I should think</gloss>

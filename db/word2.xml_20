            <gloss xml:lang="eng">er</gloss>
            <gloss xml:lang="eng">um</gloss>
            <gloss xml:lang="eng">well</gloss>
            <gloss xml:lang="eng">now</gloss>
            <gloss xml:lang="eng">you see ...</gloss>

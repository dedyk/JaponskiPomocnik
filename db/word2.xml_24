    <entry>
        <ent_seq>2439850</ent_seq>
        <k_ele>
            <keb>ヒーラ細胞</keb>
        </k_ele>
        <r_ele>
            <reb kana_type="KATAKANA_HIRAGANA" romaji="hiira saibou">ヒーラさいぼう</reb>
        </r_ele>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <s_inf xml:lang="pol">linia komórkowa wywodząca się z komórek raka szyjki macicy, pobranych od 31-letniej Henrietty Lacks, Afroamerykanki z Baltimore, bez jej zgody i przekazanych George'owi Geyowi, ówczesnemu dyrektorowi centrum badań nad kulturami tkankowymi na Uniwersytecie Johnsa Hopkinsa. Chora zmarła w 1951 roku. Komórki HeLa uważane są za nieśmiertelne, ponieważ są zdolne do nieskończenie wielu podziałów mitotycznych</s_inf>
            <gloss xml:lang="eng">HeLa cell</gloss>
            <gloss xml:lang="pol">HeLa</gloss>
        </sense>
        <misc>

        </sense>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <field>zoology</field>
            <s_inf xml:lang="pol">wieloznaczny termin stosowany w zoologii dla określenia końcowego odcinka ciała lub odwłoka niektórych zwierząt bezkręgowych, a w szczególności: końcowy odcinek ciała pierścienic, na którym umiejscowiony jest otwór odbytowy; u wieloszczetów poprzedzony prepygidium, końcowy odcinek ciała owadów</s_inf>
            <gloss xml:lang="eng">pygidium</gloss>
            <gloss xml:lang="pol">pygidium</gloss>
            <gloss xml:lang="pol">pigidium</gloss>
        </sense>
        <sense>
            <pos>noun (common) (futsuumeishi)</pos>
            <field>zoology</field>
            <gloss xml:lang="eng">pleon</gloss>
            <gloss xml:lang="pol">pleon</gloss>
        </sense>
        <sense>
